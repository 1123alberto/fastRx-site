# Destination and verified sender used only by the server-side contact function
CONTACT_EMAIL_TO=info@fastrx.gr
CONTACT_EMAIL_FROM=FastRx Website <contact@your-verified-domain.example>

# Create in Resend and configure in Vercel; never expose this value to Vite/client code
RESEND_API_KEY=re_replace_with_your_key

# Admin-FastRx internal ingestion configuration for Beta access requests (server-side only)
FASTRX_BETA_REQUEST_INGEST_URL=https://admin.fastrx.gr/api/internal/beta-requests
FASTRX_BETA_REQUEST_INGEST_SECRET=re_replace_with_internal_ingest_secret

